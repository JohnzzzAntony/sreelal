# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------- server
PORT=3000
NODE_ENV=development

# Set to 1 only when running behind a reverse proxy (nginx, Cloudflare, a PaaS
# router). It makes Express trust X-Forwarded-* headers, which secure cookies
# and the login rate limiter rely on.
TRUST_PROXY=0

# ---------------------------------------------------------------- sessions
# Required in production, minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# How long a signed-in admin session lasts. Default 8 hours.
SESSION_MAX_AGE_MS=28800000

# ---------------------------------------------------------------- admin
ADMIN_USERNAME=admin

# Preferred: a bcrypt hash, generated with
#   npm run hash -- "your password here"
ADMIN_PASSWORD_HASH=

# Development convenience only - rejected when NODE_ENV=production.
# ADMIN_PASSWORD=

# Where the admin is mounted. Change it if you prefer a less obvious path.
ADMIN_PATH=/admin

# Failed sign-in attempts allowed per IP within the window below.
ADMIN_MAX_LOGIN_ATTEMPTS=8
ADMIN_LOGIN_WINDOW_MS=900000

# ---------------------------------------------------------------- storage
# SQLite file, relative to the project root.
DATABASE_PATH=data/site.db

# Where uploaded images are written. Must sit inside the served site directory
# so the stored path resolves as an ordinary site-relative URL.
UPLOAD_DIR=IAMSREE/images/uploads

# The URL prefix matching UPLOAD_DIR, relative to the site root.
UPLOAD_URL_PREFIX=images/uploads

# 5 MB.
MAX_UPLOAD_BYTES=5242880
# SVG is excluded on purpose: an SVG can contain script, and uploads are served
# from the site origin. Add image/svg+xml only if you accept that risk.
ALLOWED_UPLOAD_TYPES=image/webp,image/png,image/jpeg,image/gif
